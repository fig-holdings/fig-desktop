{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "electron", "vite/client"]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "harness/**/*.ts", "tests/**/*.ts", "electron.vite.config.ts"]
}
