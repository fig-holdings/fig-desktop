{
  "name": "fig-desktop",
  "version": "0.1.107",
  "private": true,
  "description": "Fig Desktop — a macOS desktop home for DeepSeek Harness",
  "type": "module",
  "main": "../work/build/main/index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-desktop.mjs dev",
    "dev:isolated": "node scripts/run-desktop.mjs dev --isolated",
    "test:desktop:subscription-usage": "npm run build && node tests/subscription-usage-smoke.mjs",
    "build": "electron-vite build",
    "licenses:prepare": "node scripts/third-party-licenses.mjs --prepare",
    "test:desktop:licenses": "npm run build && node tests/third-party-licenses-smoke.mjs",
    "test:desktop:workbench-recovery": "npm run build && node tests/workbench-recovery-smoke.mjs",
    "test:desktop:workbench-jobs": "npm run build && node tests/workbench-jobs-smoke.mjs",
    "test:desktop:workbench-actions": "npm run build && node tests/workbench-agent-actions-smoke.mjs",
    "test:desktop:workbench-extension": "npm run build && node tests/workbench-extension-smoke.mjs",
    "test:desktop:workbench-review": "npm run build && node tests/workbench-review-worktree-smoke.mjs",
    "test:desktop:web-search": "npm run build && node tests/web-search-settings-smoke.mjs",
    "test:desktop:settings": "npm run build && node tests/settings-smoke.mjs",
    "test:desktop:sidebar-rail": "npm run build && node tests/sidebar-rail-smoke.mjs",
    "test:desktop:welcome-copy": "npm run build && node tests/welcome-copy-smoke.mjs",
    "test:desktop:topbar-navigation": "npm run build && node tests/topbar-navigation-smoke.mjs",
    "test:desktop:brand-orange": "npm run build && node tests/brand-orange-smoke.mjs",
    "test:desktop:project-navigation": "npm run build && node tests/project-navigation-smoke.mjs",
    "test:desktop:more-menu": "npm run build && node tests/more-menu-smoke.mjs",
    "test:desktop:input-history": "npm run build && node tests/input-history-smoke.mjs",
    "test:desktop:profile-team": "npm run build && node tests/profile-team-smoke.mjs",
    "test:desktop:cowork-edition": "npm run build && node tests/cowork-edition-smoke.mjs",
    "test:desktop:activity-layout": "npm run build && node tests/activity-layout-smoke.mjs",
    "test:desktop:session-menu": "npm run build && node tests/session-menu-smoke.mjs",
    "test:desktop:rightbar-header": "npm run build && node tests/rightbar-header-smoke.mjs",
    "test:desktop:workbench-align": "npm run build && node tests/workbench-align-smoke.mjs",
    "test:desktop:workbench-ci": "npm run build && node tests/workbench-ci-smoke.mjs",
    "test:desktop:transcript-reading": "npm run build && node tests/transcript-reading-smoke.mjs",
    "test:desktop:default-workspace": "npm run build && node tests/default-workspace-smoke.mjs",
    "test:desktop:next-step": "npm run build && node tests/next-step-smoke.mjs",
    "test:desktop:tool-views": "npm run build && node tests/tool-views-smoke.mjs",
    "test:desktop:workbench-outputs": "npm run build && node tests/workbench-outputs-smoke.mjs",
    "test:desktop:plugin-update": "npm run build && node tests/plugin-update-smoke.mjs",
    "test:desktop:baseline": "npm run build && node tests/run-smokes.mjs desktop error identity sidebar-rail settings input-history",
    "package:mac": "node scripts/package-flow.mjs",
    "plugin:pack": "node --import tsx scripts/plugin-update.mjs pack",
    "plugin:install": "node --import tsx scripts/plugin-update.mjs install",
    "plugin:list": "node --import tsx scripts/plugin-update.mjs list",
    "plugin:revert": "node --import tsx scripts/plugin-update.mjs revert",
    "plugin:ship": "node --import tsx scripts/plugin-update.mjs ship",
    "start": "node scripts/run-desktop.mjs preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.plugins.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:desktop": "npm run build && node tests/desktop-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:desktop:error": "npm run build && node tests/error-smoke.mjs",
    "test:desktop:real": "npm run build && node tests/desktop-smoke.mjs --real --reuse",
    "test:dev": "node tests/dev-smoke.mjs",
    "test:desktop:onboarding": "npm run build && node tests/onboarding-smoke.mjs",
    "test:desktop:onboarding:dev": "npm run build && node tests/onboarding-smoke.mjs --dev",
    "dsh:verify": "node scripts/dsh-verify.mjs",
    "test:desktop:identity": "npm run build && node tests/identity-smoke.mjs",
    "test:desktop:language": "npm run build && node tests/language-smoke.mjs",
    "test:desktop:side-chat": "npm run build && node tests/side-chat-smoke.mjs",
    "test:desktop:side-chat:real": "npm run build && node tests/side-chat-real-smoke.mjs --real",
    "test:desktop:plugin-failure": "npm run build && node tests/plugin-failure-smoke.mjs",
    "test:desktop:plugin-install": "npm run build && node tests/plugin-install-smoke.mjs",
    "test:desktop:plugin-compat": "npm run build && node tests/plugin-compat-smoke.mjs",
    "test:desktop:plugin-overlap": "npm run build && node tests/plugin-overlap-smoke.mjs",
    "test:desktop:plugin-toggle": "npm run build && node tests/plugin-toggle-smoke.mjs",
    "test:packages": "npm run build && node --import tsx tests/package-standalone-smoke.mjs",
    "test:official-web": "npm run build && node --import tsx tests/official-web-smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-vite": "6.0.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  },
  "productName": "Fig Desktop"
}
