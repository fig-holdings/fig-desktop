{
  "name": "@local/dsh-provider-grok",
  "version": "0.1.1",
  "private": true,
  "description": "Grok subscription models through the local Grok CLI sign-in, with an account page. Local use only.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./bundle.patch.yml": "./bundle.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}
