{
  "name": "@local/dsh-rule-sources",
  "version": "0.1.0",
  "private": true,
  "description": "Rule sources: which AGENTS.md files the open session uses, and whether they changed since they were read.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./bundle.patch.yml": "./bundle.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
